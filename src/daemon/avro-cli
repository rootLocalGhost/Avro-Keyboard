#!/usr/bin/env python3
import socket
import sys
import json

SOCKET_PATH = "/tmp/avro.sock"

def send_command(cmd):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(SOCKET_PATH)
            # Drain initial state broadcast
            s.recv(1024)
            s.sendall(cmd.encode("utf-8"))
            if cmd in ["get-mode", "get-layout"] or cmd.startswith("convert "):
                response = s.recv(1024).decode("utf-8").strip()
                print(response)
    except FileNotFoundError:
        print("Error: avro-daemon is not running.")
        sys.exit(1)

def monitor():
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(SOCKET_PATH)
            while True:
                data = s.recv(1024)
                if not data:
                    break
                lines = data.decode("utf-8").strip().split('\n')
                for line in lines:
                    if line:
                        print(line, flush=True)
    except FileNotFoundError:
        print("Error: avro-daemon is not running.")
        sys.exit(1)
    except KeyboardInterrupt:
        pass

def main():
    if len(sys.argv) < 2:
        print("Usage: avro-cli [toggle|get-mode|get-layout|set-layout <name>|monitor|convert <word>]")
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "monitor":
        monitor()
    elif cmd in ["toggle", "get-mode", "get-layout"]:
        send_command(cmd)
    elif cmd == "set-layout" and len(sys.argv) >= 3:
        send_command(f"set-layout {' '.join(sys.argv[2:])}")
    elif cmd == "convert" and len(sys.argv) >= 3:
        send_command(f"convert {' '.join(sys.argv[2:])}")
    else:
        print("Invalid command")
        sys.exit(1)

if __name__ == "__main__":
    main()
