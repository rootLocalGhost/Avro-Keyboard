#!/usr/bin/env python3
import socket
import os
import sys
import threading
import json
import ctypes

SOCKET_PATH = "/tmp/avro.sock"
LIB_PATH = "/usr/lib/libavrocore.so"
LOCAL_LIB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../build/libavrocore.so")

# Application State
state = {
    "mode": "EN",
    "layout": "Avro Phonetic"
}
clients = []

# Try loading libavrocore
libavro = None
try:
    if os.path.exists(LIB_PATH):
        libavro = ctypes.CDLL(LIB_PATH)
    elif os.path.exists(LOCAL_LIB_PATH):
        libavro = ctypes.CDLL(LOCAL_LIB_PATH)
    else:
        print("Warning: libavrocore.so not found, running in mock mode.")
except OSError as e:
    print(f"Error loading libavrocore.so: {e}")

if libavro:
    libavro.avro_init.argtypes = []
    libavro.avro_init.restype = None
    libavro.avro_convert.argtypes = [ctypes.c_char_p]
    libavro.avro_convert.restype = ctypes.c_void_p
    libavro.avro_free_string.argtypes = [ctypes.c_void_p]
    libavro.avro_free_string.restype = None
    libavro.avro_cleanup.argtypes = []
    libavro.avro_cleanup.restype = None

    # Initialize the Avro engine
    libavro.avro_init()

def notify_clients():
    msg = json.dumps(state) + "\n"
    for c in list(clients):
        try:
            c.sendall(msg.encode("utf-8"))
        except:
            clients.remove(c)

def handle_client(conn):
    with conn:
        clients.append(conn)
        try:
            # Send initial state
            conn.sendall((json.dumps(state) + "\n").encode("utf-8"))
            while True:
                data = conn.recv(1024)
                if not data:
                    break
                command = data.decode("utf-8").strip()
                if command == "toggle":
                    state["mode"] = "BN" if state["mode"] == "EN" else "EN"
                    notify_clients()
                elif command == "get-mode":
                    conn.sendall((state["mode"] + "\n").encode("utf-8"))
                elif command == "get-layout":
                    conn.sendall((state["layout"] + "\n").encode("utf-8"))
                elif command.startswith("set-layout "):
                    state["layout"] = command.split(" ", 1)[1]
                    notify_clients()
                elif command.startswith("convert "):
                    word = command.split(" ", 1)[1]
                    if libavro and state["mode"] == "BN":
                        c_word = word.encode("utf-8")
                        res_ptr = libavro.avro_convert(c_word)
                        if res_ptr:
                            res_str = ctypes.cast(res_ptr, ctypes.c_char_p).value.decode("utf-8")
                            libavro.avro_free_string(res_ptr)
                            conn.sendall((res_str + "\n").encode("utf-8"))
                        else:
                            conn.sendall((word + "\n").encode("utf-8"))
                    else:
                        conn.sendall((word + "\n").encode("utf-8"))
        except:
            pass
        finally:
            if conn in clients:
                clients.remove(conn)

def main():
    if os.path.exists(SOCKET_PATH):
        os.remove(SOCKET_PATH)

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.bind(SOCKET_PATH)
        s.listen()
        print(f"Daemon listening on {SOCKET_PATH}...")
        try:
            while True:
                conn, _ = s.accept()
                threading.Thread(target=handle_client, args=(conn,), daemon=True).start()
        finally:
            if libavro:
                libavro.avro_cleanup()

if __name__ == "__main__":
    main()
